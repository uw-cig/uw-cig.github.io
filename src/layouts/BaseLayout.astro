---
import "../styles/global.css";
import { site } from "../utils/site";

interface Props {
	title: string;
	// For search results and link previews; defaults to `description` in site.yml.
	description?: string;
	// Link-preview image: a path under public/ or an absolute URL.
	image?: string;
	imageAlt?: string;
	// "article" for news posts.
	type?: "website" | "article";
	// Keeps the page out of search results (e.g. the 404 page).
	noindex?: boolean;
}

const {
	title,
	description = site.description,
	image = "/og-default.png",
	imageAlt = `${site.name}, ${site.university}`,
	type = "website",
	noindex = false,
} = Astro.props;

if (!Astro.site) throw new Error("astro.config.mjs: `site` must be set for canonical and link-preview URLs");
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

// x.com/uwcig -> @uwcig
const xLink = site.links.find((l) => /^https?:\/\/(www\.)?(x|twitter)\.com\/\w+/.test(l.url));
const twitterHandle = xLink && `@${new URL(xLink.url).pathname.split("/")[1]}`;

// Structured data for the group, on the homepage. The last address line is
// split into city, state and ZIP when it looks like "Madison, WI 53715".
const cityLine = site.address.at(-1)!.match(/^(.+?),\s*([A-Z]{2})\s+(\d{5}(?:-\d{4})?)$/);
const organization = {
	"@context": "https://schema.org",
	"@type": "ResearchOrganization",
	name: site.name,
	alternateName: `${site.university_short} ${site.short_name}`,
	url: Astro.site.href,
	logo: new URL("/icon-512.png", Astro.site).href,
	email: site.email,
	address: {
		"@type": "PostalAddress",
		streetAddress: (cityLine ? site.address.slice(0, -1) : site.address).join(", "),
		...(cityLine && {
			addressLocality: cityLine[1],
			addressRegion: cityLine[2],
			postalCode: cityLine[3],
			addressCountry: "US",
		}),
	},
	sameAs: [...site.links.map((l) => l.url), site.google_scholar],
};

const navLinks = [
	{ href: "/", label: "Home" },
	{ href: "/team/", label: "Team" },
	{ href: "/publications/", label: "Publications" },
	{ href: "/teaching/", label: "Teaching" },
	{ href: "/news/", label: "News" },
	{ href: "/join/", label: "Join" },
];

const stripSlash = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = stripSlash(Astro.url.pathname);
// The homepage is titled with the group's full name; other pages are "Page · UW–Madison CIG".
const fullTitle =
	currentPath === "/" ? `${site.university_short} ${site.name}` : `${title} · ${site.university_short} ${site.short_name}`;
const year = new Date().getFullYear();

const footerLinks = [
	{ label: site.email, href: `mailto:${site.email}`, external: false },
	...site.links.map(({ label, url }) => ({ label, href: url, external: true })),
	{ label: "Google Scholar", href: site.google_scholar, external: true },
];
const footerLabel = "text-xs font-semibold tracking-widest text-accent uppercase";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		{site.google_site_verification && <meta name="google-site-verification" content={site.google_site_verification} />}

		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		{!noindex && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={`${site.name} · ${site.university_short}`} />
		<meta name="twitter:card" content="summary_large_image" />
		{twitterHandle && <meta name="twitter:site" content={twitterHandle} />}

		{
			currentPath === "/" && (
				<script type="application/ld+json" is:inline set:html={JSON.stringify(organization).replace(/</g, "\\u003c")} />
			)
		}
	</head>
	<body class="flex min-h-screen flex-col bg-background text-ink">
		<header class="border-b-2 border-accent">
			<div class="mx-auto flex max-w-[960px] flex-wrap items-center justify-between gap-x-4 gap-y-3 px-6 py-4 sm:gap-x-8">
				<a href="/" class="flex items-center gap-3 leading-tight">
					<img src="/favicon.svg" alt="" aria-hidden="true" width="40" height="40" class="size-8 shrink-0 sm:size-10" />
					<span>
						<span class="block text-[15px] font-semibold sm:text-[16px]">{site.name}</span>
						<span class="block text-xs text-muted sm:text-sm">{site.university}</span>
					</span>
				</a>

				<button
					id="nav-toggle"
					type="button"
					class="rounded border border-line px-3 py-1 text-sm md:hidden"
					aria-controls="site-nav"
					aria-expanded="false"
				>
					Menu
				</button>

				<nav id="site-nav" class="hidden w-full md:block md:w-auto" aria-label="Main">
					<ul class="flex flex-col gap-2 md:flex-row md:gap-6">
						{
							navLinks.map(({ href, label }) => {
								const isCurrent = stripSlash(href) === currentPath;
								return (
									<li>
										<a
											href={href}
											aria-current={isCurrent ? "page" : undefined}
											class:list={[
												"inline-block border-b-2 pb-0.5",
												isCurrent
													? "border-accent text-accent"
													: "border-transparent text-ink hover:text-accent",
											]}
										>
											{label}
										</a>
									</li>
								);
							})
						}
					</ul>
				</nav>
			</div>
		</header>

		<main class="mx-auto w-full max-w-[960px] flex-1 px-6 py-10">
			<slot />
		</main>

		<footer class="border-t border-line bg-surface">
			<div class="mx-auto max-w-[960px] px-6 pt-10 pb-6">
				<div class="grid gap-8 md:grid-cols-3">
					<div>
						<p class={footerLabel}>{site.university}</p>
						<p class="mt-2 text-xl leading-snug font-semibold">{site.name}</p>
					</div>

					<div>
						<p class={footerLabel}>Find us</p>
						<address class="mt-2 text-sm leading-6 text-muted not-italic">
							{site.address.map((line) => <span class="block">{line}</span>)}
						</address>
					</div>

					<div>
						<p class={footerLabel}>Get in touch</p>
						<ul class="mt-2 space-y-1 text-sm leading-6 text-muted">
							{
								footerLinks.map(({ label, href, external }) => (
									<li>
										<a
											href={href}
											class="hover:text-accent"
											target={external ? "_blank" : undefined}
											rel={external ? "noopener" : undefined}
										>
											{label}
											{external && (
												<>
													<span aria-hidden="true"> ↗</span>
													<span class="sr-only"> (opens in a new tab)</span>
												</>
											)}
										</a>
									</li>
								))
							}
						</ul>
					</div>
				</div>

				<div class="mt-10 flex flex-col gap-3 border-t border-line pt-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
					<div class="flex items-center gap-2">
						<img src="/favicon.svg" alt="" aria-hidden="true" width="24" height="24" class="size-6" />
						<span class="font-medium text-ink">{site.name}</span>
					</div>
					<p>© {year} {site.name} · <span class="whitespace-nowrap">{site.university_short}</span></p>
				</div>
			</div>
		</footer>

		<script>
			const toggle = document.getElementById("nav-toggle");
			const nav = document.getElementById("site-nav");
			toggle?.addEventListener("click", () => {
				const open = toggle.getAttribute("aria-expanded") === "true";
				toggle.setAttribute("aria-expanded", String(!open));
				nav?.classList.toggle("hidden", open);
			});
		</script>
	</body>
</html>
