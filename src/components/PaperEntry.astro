---
import type { CollectionEntry } from "astro:content";

interface Props {
	paper: CollectionEntry<"papers">["data"];
	category: string;
	venue?: CollectionEntry<"venues">["data"];
}

const { paper, category, venue } = Astro.props;

const HIGHLIGHT = "U. S. Kamilov";
const MAX_AUTHORS = 5;
const SHOWN_AUTHORS = 3;

// "A and B", "A, B, and C"
const separator = (i: number, n: number) => (i === n - 1 ? "" : n === 2 ? " and " : i === n - 2 ? ", and " : ", ");

const known = venue !== undefined;
const badgeColor = venue?.color ?? (known ? "var(--color-accent)" : "var(--color-muted)");

const pages = paper.pages && `${/[–-]/.test(paper.pages) ? "pp." : "p."} ${paper.pages}`;
const details = [
	paper.volume && `vol. ${paper.volume}`,
	paper.number && `no. ${paper.number}`,
	pages,
	paper.address,
	paper.year,
].filter(Boolean);

const links = [
	{ label: "arXiv", href: paper.arxiv && `https://arxiv.org/abs/${paper.arxiv}` },
	{ label: "PDF", href: paper.pdf },
	{ label: "HTML", href: paper.html ?? (paper.doi && `https://doi.org/${paper.doi}`) },
	{ label: "Code", href: paper.code },
	{ label: "Website", href: paper.website },
].filter((l) => l.href);

// Lowercased, accent-free text that the search box matches against.
const searchText = [paper.title, ...paper.authors, paper.venue, paper.abbr, paper.year]
	.filter(Boolean)
	.join(" ")
	.normalize("NFKD")
	.replace(/\p{M}/gu, "")
	.toLowerCase();

const bibId = `bib-${paper.id}`;
const buttonClass =
	"rounded border border-line px-2 py-0.5 text-xs hover:border-accent hover:text-accent aria-expanded:border-accent aria-expanded:text-accent";
---

<li data-paper data-category={category} data-award={paper.award !== undefined} data-search={searchText} class="grid gap-x-5 gap-y-2 sm:grid-cols-[6.5rem_1fr]">
	<div>
		{
			paper.abbr &&
				(venue?.url ? (
					<a
						href={venue.url}
						class="inline-block rounded px-2 py-0.5 text-center text-xs font-semibold text-white hover:opacity-85 sm:w-full"
						style={`background-color: ${badgeColor}`}
					>
						{paper.abbr}
					</a>
				) : (
					<span
						class="inline-block rounded px-2 py-0.5 text-center text-xs font-semibold text-white sm:w-full"
						style={`background-color: ${badgeColor}`}
					>
						{paper.abbr}
					</span>
				))
		}
	</div>

	<div class="min-w-0">
		<p class="leading-snug font-semibold">
			{paper.title}
			{
				paper.award && (
					<span role="img" aria-label="Award" title="Award" class="ml-1 font-normal text-gold">
						★
					</span>
				)
			}
		</p>

		<p class="mt-1 text-sm">
			{
				paper.authors.length > MAX_AUTHORS ? (
					<>
						<span data-authors-short>
							{paper.authors.slice(0, SHOWN_AUTHORS).map((name) => (
								<>
									{name === HIGHLIGHT ? <strong>{name}</strong> : name}
									{", "}
								</>
							))}
							<button type="button" data-more-authors class="text-accent hover:underline">
								and {paper.authors.length - SHOWN_AUTHORS} more authors
							</button>
						</span>
						<span data-authors-full hidden>
							{paper.authors.map((name, i, all) => (
								<>
									{name === HIGHLIGHT ? <strong>{name}</strong> : name}
									{separator(i, all.length)}
								</>
							))}
						</span>
					</>
				) : (
					paper.authors.map((name, i, all) => (
						<>
							{name === HIGHLIGHT ? <strong>{name}</strong> : name}
							{separator(i, all.length)}
						</>
					))
				)
			}
		</p>

		<p class="mt-1 text-sm text-muted">
			{paper.venue && <em>{paper.venue}</em>}
			{paper.venue && details.length > 0 && ", "}
			{details.join(", ")}
		</p>

		{
			paper.award && (
				<p class="mt-1 text-sm font-medium text-gold">
					<span aria-hidden="true">★</span> {paper.award}
				</p>
			)
		}

		<div class="mt-2 flex flex-wrap gap-2">
			{
				links.map(({ label, href }) => (
					<a href={href} class={buttonClass}>
						{label}
					</a>
				))
			}
			<button type="button" data-bib-toggle aria-expanded="false" aria-controls={bibId} class={buttonClass}>
				Bib
			</button>
		</div>

		<div id={bibId} hidden class="relative mt-3">
			<pre class="overflow-x-auto rounded border border-line bg-surface p-3 pr-16 text-xs"><code>{paper.bibtex}</code></pre>
			<button
				type="button"
				data-bib-copy
				class="absolute top-2 right-2 rounded border border-line bg-background px-2 py-0.5 text-xs hover:border-accent hover:text-accent"
			>
				Copy
			</button>
		</div>
	</div>
</li>
