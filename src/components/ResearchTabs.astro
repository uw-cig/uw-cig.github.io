---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";

const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/research/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG}", {
	eager: true,
});

const areas = (await getCollection("research"))
	.map((entry) => ({ id: entry.id, ...entry.data, picture: images[`/src/assets/research/${entry.data.image}`]?.default }))
	.sort((a, b) => a.order - b.order);

for (const area of areas) {
	if (!area.picture) console.warn(`src/data/research.yml: src/assets/research/${area.image} not found; showing a placeholder`);
}
---

{
	areas.length > 0 && (
		<div data-tabs>
			<div role="tablist" aria-label="Research areas" class="grid grid-cols-2 gap-2 sm:flex sm:flex-wrap">
				{areas.map((area, i) => (
					<button
						type="button"
						role="tab"
						id={`research-tab-${area.id}`}
						aria-controls={`research-panel-${area.id}`}
						aria-selected={i === 0 ? "true" : "false"}
						tabindex={i === 0 ? 0 : -1}
						class="rounded-full border border-line px-2 py-1.5 text-xs tracking-tight sm:px-4 sm:text-sm sm:tracking-normal aria-selected:border-accent aria-selected:bg-accent aria-selected:text-white aria-[selected=false]:hover:border-accent aria-[selected=false]:hover:text-accent"
					>
						{area.title}
					</button>
				))}
			</div>

			{areas.map((area, i) => (
				<div
					role="tabpanel"
					id={`research-panel-${area.id}`}
					aria-labelledby={`research-tab-${area.id}`}
					tabindex="0"
					hidden={i !== 0}
					class="mt-6 grid items-center gap-6 md:grid-cols-[55%_1fr] md:gap-8"
				>
					{area.picture ? (
						<Picture
							src={area.picture}
							alt=""
							formats={["avif", "webp"]}
							fallbackFormat="jpg"
							width={1600}
							widths={[480, 640, 800, 1024, 1280, 1600]}
							sizes="(min-width: 960px) 502px, (min-width: 768px) 55vw, calc(100vw - 48px)"
							loading={i === 0 ? "eager" : "lazy"}
							class="aspect-video h-auto w-full rounded-lg object-cover"
						/>
					) : (
						<div class="aspect-video w-full rounded-lg bg-neutral-700" />
					)}
					<div>
						<h3 class="text-xl font-semibold">{area.title}</h3>
						<p class="mt-2">{area.summary}</p>
						{area.query && (
							<a
								href={`/publications/?q=${encodeURIComponent(area.query.join(" | "))}`}
								class="mt-4 inline-block text-accent hover:underline"
							>
								Related publications →
							</a>
						)}
					</div>
				</div>
			))}

			{/* Without JavaScript, show every area one after another instead of tabs. The rule
			   must be in Tailwind's base layer to override its important [hidden] rule. */}
			<noscript>
				<style is:inline>
					[data-tabs] [role="tablist"] { display: none; }
					@layer base { [data-tabs] [role="tabpanel"][hidden] { display: grid !important; } }
				</style>
			</noscript>
		</div>
	)
}

<script>
	for (const root of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];

		const select = (tab: HTMLButtonElement, focus = false) => {
			for (const t of tabs) {
				const selected = t === tab;
				t.setAttribute("aria-selected", String(selected));
				t.tabIndex = selected ? 0 : -1;
				document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !selected;
			}
			if (focus) tab.focus();
		};

		for (const [i, tab] of tabs.entries()) {
			tab.addEventListener("click", () => select(tab));
			tab.addEventListener("keydown", (event) => {
				const next = {
					ArrowRight: tabs[(i + 1) % tabs.length],
					ArrowLeft: tabs[(i - 1 + tabs.length) % tabs.length],
					Home: tabs[0],
					End: tabs[tabs.length - 1],
				}[event.key];
				if (next) {
					event.preventDefault();
					select(next, true);
				}
			});
		}
	}
</script>
