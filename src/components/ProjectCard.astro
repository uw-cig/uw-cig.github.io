---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";

export type ProjectMedia =
	| { kind: "image"; image: ImageMetadata }
	| { kind: "gif"; src: string }
	| { kind: "video"; src: string };

interface Props {
	project: CollectionEntry<"projects">["data"];
	media?: ProjectMedia;
	// Name → website, for mentors (team.yml) and students (students.yml).
	mentorSites: Map<string, string | undefined>;
	studentSites: Map<string, string | undefined>;
}

const { project, media, mentorSites, studentSites } = Astro.props;
const reserved = project.status === "reserved";
const studentSite = project.student ? studentSites.get(project.student) : undefined;
const badge = "inline-block rounded-full px-2.5 py-0.5 text-xs font-semibold text-white";
const link = "hover:text-accent hover:underline";
const mediaClass = "aspect-square h-auto w-full rounded object-cover";
---

<article
	data-project={project.status}
	class:list={["flex flex-col gap-4 rounded-lg border border-line p-4 sm:flex-row sm:gap-6", reserved && "opacity-70"]}
>
	<div class="mx-auto w-full max-w-[320px] shrink-0 sm:mx-0 sm:w-1/4 sm:max-w-none">
		{
			media?.kind === "image" ? (
				<Picture
					src={media.image}
					alt=""
					formats={["avif", "webp"]}
					fallbackFormat="jpg"
					width={640}
					widths={[240, 320, 480, 640]}
					sizes="(min-width: 960px) 214px, (min-width: 640px) calc((100vw - 106px) / 4), min(320px, 100vw - 82px)"
					loading="lazy"
					class={mediaClass}
				/>
			) : media?.kind === "gif" ? (
				<img src={media.src} alt="" loading="lazy" class={mediaClass} />
			) : media?.kind === "video" ? (
				// The script on the join page sets `src` once the video scrolls into view.
				<video
					data-project-video
					data-src={media.src}
					muted
					loop
					playsinline
					preload="none"
					aria-hidden="true"
					class={mediaClass}
				/>
			) : (
				<div class="aspect-square w-full rounded bg-surface" />
			)
		}
	</div>

	<div class="min-w-0 flex-1">
		<div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
			{
				reserved ? (
					<span class:list={[badge, "bg-muted"]}>
						Reserved ·{" "}
						{studentSite ? (
							<a href={studentSite} class="hover:underline">
								{project.student}
							</a>
						) : (
							project.student
						)}
					</span>
				) : (
					<span class:list={[badge, "bg-green"]}>Available</span>
				)
			}
			<span>{project.semester}</span>
			{
				project.level && project.level.length > 0 && (
					<ul class="flex gap-2" aria-label="Level">
						{project.level.map((level) => (
							<li class="rounded border border-line px-2 py-0.5 text-xs">{level}</li>
						))}
					</ul>
				)
			}
		</div>

		<h3 class="mt-2 text-lg leading-snug font-semibold">{project.title}</h3>

		<p class="mt-1 text-sm text-muted">
			Mentors:{" "}
			{
				project.mentors.map((name, i) => (
					<>
						{i > 0 && ", "}
						{mentorSites.get(name) ? (
							<a href={mentorSites.get(name)} class={link}>
								{name}
							</a>
						) : (
							name
						)}
					</>
				))
			}
		</p>

		<p class="mt-2 text-sm">{project.description}</p>
	</div>
</article>
