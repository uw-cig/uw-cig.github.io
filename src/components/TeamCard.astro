---
import { existsSync } from "node:fs";
import { join } from "node:path";
import type { CollectionEntry } from "astro:content";
import { thesisLinks } from "../utils/theses";

interface Props {
	member: CollectionEntry<"team">["data"];
}

const { member } = Astro.props;

const typeLabels = {
	pi: "Principal Investigator",
	postdoc: "Postdoc",
	phd: "PhD Student",
} as const;

const alumniLabels = {
	pi: "PI",
	postdoc: "Postdoc",
	phd: "PhD",
} as const;

const thesisUrl = member.thesis_key && (await thesisLinks()).get(member.thesis_key);
const hasPhoto = existsSync(join(process.cwd(), "public/images/team", member.photo));
const roleLines = member.current_role ?? [`${typeLabels[member.type]}, ${member.institution}`];

// The photo links to the same page as the name, but is hidden from keyboard
// and screen readers since the name link already covers it.
const PhotoLink = member.website ? "a" : Fragment;
const photoLinkProps = member.website
	? {
			href: member.website,
			tabindex: "-1",
			"aria-hidden": "true",
			class: "shrink-0 transition-opacity hover:opacity-80",
		}
	: {};
---

<article class="flex items-start gap-5">
	<PhotoLink {...photoLinkProps}>
	{
		hasPhoto ? (
			<img
				src={`/images/team/${member.photo}`}
				alt={member.name}
				width="125"
				height="125"
				loading="lazy"
				class="size-[125px] shrink-0 rounded-full object-cover"
			/>
		) : (
			<div class="size-[125px] shrink-0 rounded-full border border-line bg-surface" role="img" aria-label={member.name} />
		)
	}
	</PhotoLink>

	<div class="min-w-0 pt-2">
		<h3 class="text-lg leading-snug font-semibold">
			{
				member.website ? (
					<a href={member.website} class="hover:text-accent hover:underline">
						{member.name}
					</a>
				) : (
					member.name
				)
			}
		</h3>

		{
			member.current ? (
				roleLines.map((line, i) => (
					<p class:list={["mt-1", member.type === "pi" && i > 0 && "text-sm text-muted"]}>{line}</p>
				))
			) : (
				<>
					<p class="mt-1 text-sm text-muted">
						{alumniLabels[member.type]} {member.year}
					</p>
					{member.current_role?.map((line, i) => (
						<p class="mt-1">{i === 0 ? `Now: ${line}` : line}</p>
					))}
					{member.thesis && (
						<p class="mt-1 text-sm text-muted italic">
							Thesis:{" "}
							{thesisUrl ? (
								<a href={thesisUrl} class="hover:text-accent hover:underline">
									{member.thesis}
								</a>
							) : (
								member.thesis
							)}
						</p>
					)}
				</>
			)
		}

		{member.focus && <p class="mt-1 text-sm text-muted">Focus: {member.focus}</p>}
	</div>
</article>
