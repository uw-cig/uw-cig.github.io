---
import { existsSync } from "node:fs";
import { join } from "node:path";
import type { CollectionEntry } from "astro:content";

interface Props {
	member: CollectionEntry<"team">["data"];
}

const { member } = Astro.props;

const typeLabels = {
	pi: "Principal Investigator",
	postdoc: "Postdoc",
	phd: "PhD Student",
} as const;

const alumniLabels = {
	pi: "PI",
	postdoc: "Postdoc",
	phd: "PhD",
} as const;

const hasPhoto = existsSync(join(process.cwd(), "public/images/team", member.photo));
const roleLines = member.current_role ?? [`${typeLabels[member.type]}, ${member.institution}`];
---

<article class="flex items-start gap-5">
	{
		hasPhoto ? (
			<img
				src={`/images/team/${member.photo}`}
				alt={member.name}
				width="125"
				height="125"
				loading="lazy"
				class="size-[125px] shrink-0 rounded-full object-cover"
			/>
		) : (
			<div class="size-[125px] shrink-0 rounded-full border border-line bg-surface" role="img" aria-label={member.name} />
		)
	}

	<div class="min-w-0 pt-2">
		<h3 class="text-lg leading-snug font-semibold">
			{
				member.website ? (
					<a href={member.website} class="hover:text-accent hover:underline">
						{member.name}
					</a>
				) : (
					member.name
				)
			}
		</h3>

		{
			member.current ? (
				roleLines.map((line, i) => (
					<p class:list={["mt-1", member.type === "pi" && i > 0 && "text-sm text-muted"]}>{line}</p>
				))
			) : (
				<>
					<p class="mt-1 text-sm text-muted">
						{alumniLabels[member.type]} {member.year}
					</p>
					{member.current_role?.map((line, i) => (
						<p class="mt-1">{i === 0 ? `Now: ${line}` : line}</p>
					))}
					{member.thesis && <p class="mt-1 text-sm text-muted italic">Thesis: {member.thesis}</p>}
				</>
			)
		}

		{member.focus && <p class="mt-1 text-sm text-muted">Focus: {member.focus}</p>}
	</div>
</article>
