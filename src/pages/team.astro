---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TeamCard from "../components/TeamCard.astro";
import GroupPhoto from "../components/GroupPhoto.astro";
import { termKey } from "../utils/terms";

const members = (await getCollection("team")).map((entry) => entry.data);
type Member = (typeof members)[number];

const byName = (a: Member, b: Member) => a.name.localeCompare(b.name);
const byYearDesc = (a: Member, b: Member) => (b.year ?? 0) - (a.year ?? 0) || byName(a, b);

const current = (type: Member["type"]) => members.filter((m) => m.current && m.type === type).sort(byName);
const alumni = (type: Member["type"]) => members.filter((m) => !m.current && m.type === type).sort(byYearDesc);

const students = (await getCollection("students")).map((entry) => entry.data);
type Student = (typeof students)[number];

const currentStudents = students.filter((s) => s.current).sort((a, b) => a.name.localeCompare(b.name));
const formerStudents = students
	.filter((s) => !s.current)
	.sort((a, b) => termKey(b.end!) - termKey(a.end!) || a.name.localeCompare(b.name));

const mentorSites = new Map(members.map((m) => [m.name, m.website]));
// Former Student Researchers and Visitors show this many rows, with a
// button to show the rest when there are more.
const ROW_LIMIT = 10;
const collapseButtonClass =
	"mt-4 inline-block rounded-full border border-line px-4 py-1.5 text-sm hover:border-accent hover:text-accent";

const termRange = (s: Student) => (s.start === s.end ? s.start : `${s.start} – ${s.end}`);
const programLabel = (s: Student) => `${s.program ? `${s.program} Student` : "Student Researcher"}, ${s.institution}`;

const visitors = (await getCollection("visitors")).map((entry) => entry.data);
type Visitor = (typeof visitors)[number];

const visitorYear = (v: Visitor) => Number(v.end ?? v.start);
const sortedVisitors = visitors.sort((a, b) => visitorYear(b) - visitorYear(a) || a.name.localeCompare(b.name));
const visitorTypes: Record<Visitor["type"], string> = {
	phd: "Visiting PhD Student",
	student: "Visiting Student",
	intern: "Intern",
};
const visitorYears = (v: Visitor) => (v.end && v.end !== v.start ? `${v.start}–${v.end}` : v.start);

const currentSections = [
	{ title: "Principal Investigator", people: current("pi"), fullWidth: true },
	{ title: "Postdocs", people: current("postdoc") },
	{ title: "PhD Students", people: current("phd") },
].filter((s) => s.people.length > 0);

const alumniSections = [
	{ title: "PhD Alumni", people: alumni("phd") },
	{ title: "Postdoc Alumni", people: alumni("postdoc") },
].filter((s) => s.people.length > 0);
---

<BaseLayout
	title="Team"
	description="Meet the people of the Computational Imaging Group at UW–Madison: Prof. Ulugbek Kamilov, postdocs, PhD students, student researchers, and alumni."
>
	<h1 class="mb-4 text-3xl font-semibold">Team</h1>

	<GroupPhoto />
	{
		currentSections.map(({ title, people, fullWidth }) => (
			<section class="mt-10">
				<h2 class="mb-6 border-b border-line pb-2 text-xl font-semibold">{title}</h2>
				<div class:list={["grid gap-8", !fullWidth && "sm:grid-cols-2"]}>
					{people.map((member) => (
						<TeamCard member={member} />
					))}
				</div>
			</section>
		))
	}

	{
		currentStudents.length > 0 && (
			<section class="mt-10">
				<h2 class="mb-6 border-b border-line pb-2 text-xl font-semibold">Student Researchers</h2>
				<ul class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
					{currentStudents.map((s) => (
						<li>
							<h3 class="font-semibold">
								{s.website ? (
									<a href={s.website} class="hover:text-accent hover:underline">
										{s.name}
									</a>
								) : (
									s.name
								)}
							</h3>
							<p class="text-sm">{programLabel(s)}</p>
							<p class="text-sm text-muted italic">{s.project}</p>
							{s.mentor && (
								<p class="text-sm text-muted">
									{s.mentor.length > 1 ? "Mentors" : "Mentor"}:{" "}
									{s.mentor.map((name, i) => (
										<>
											{i > 0 && ", "}
											{mentorSites.get(name) ? (
												<a href={mentorSites.get(name)} class="hover:text-accent hover:underline">
													{name}
												</a>
											) : (
												name
											)}
										</>
									))}
								</p>
							)}
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		(alumniSections.length > 0 || formerStudents.length > 0 || sortedVisitors.length > 0) && (
			<section class="mt-14">
				<h2 class="mb-6 border-b border-line pb-2 text-xl font-semibold">Alumni</h2>
				{alumniSections.map(({ title, people }) => (
					<div class="mt-8 first:mt-0">
						<h3 class="mb-6 text-sm font-semibold tracking-wide text-muted uppercase">{title}</h3>
						<div class="grid gap-8 sm:grid-cols-2">
							{people.map((member) => (
								<TeamCard member={member} />
							))}
						</div>
					</div>
				))}
				{formerStudents.length > 0 && (
					<div class="mt-8 first:mt-0" data-collapsible>
						<h3 class="mb-6 text-sm font-semibold tracking-wide text-muted uppercase" data-collapsible-heading>
							Former Student Researchers
						</h3>
						<table class="block w-full text-sm sm:table">
							<thead class="hidden sm:table-header-group">
								<tr class="border-b border-line text-left">
									<th class="py-2 pr-4 font-semibold">Name</th>
									<th class="py-2 pr-4 font-semibold">Program</th>
									<th class="py-2 pr-4 font-semibold">Term</th>
									<th class="py-2 pr-4 font-semibold">Project</th>
									<th class="py-2 font-semibold">Mentor</th>
								</tr>
							</thead>
							<tbody id="former-students-rows" class="block sm:table-row-group">
								{formerStudents.map((s, i) => {
									return (
										<tr
											class="block border-b border-line py-3 align-top sm:table-row sm:py-0"
											data-overflow={i >= ROW_LIMIT ? "" : undefined}
										>
											<td class="block font-semibold sm:table-cell sm:py-2 sm:pr-4">
												{s.website ? (
													<a href={s.website} class="hover:text-accent hover:underline">
														{s.name}
													</a>
												) : (
													s.name
												)}
											</td>
											<td
												data-label="Program: "
												class="block before:text-muted before:content-[attr(data-label)] sm:table-cell sm:py-2 sm:pr-4 sm:before:content-none"
											>
												{s.program ? `${s.program}, ${s.institution}` : s.institution}
											</td>
											<td
												data-label="Term: "
												class="block before:text-muted before:content-[attr(data-label)] sm:table-cell sm:py-2 sm:pr-4 sm:whitespace-nowrap sm:before:content-none"
											>
												{termRange(s)}
											</td>
											<td
												data-label="Project: "
												class="block italic before:text-muted before:not-italic before:content-[attr(data-label)] sm:table-cell sm:py-2 sm:pr-4 sm:before:content-none"
											>
												{s.project}
											</td>
											<td
												data-label={(s.mentor?.length ?? 0) > 1 ? "Mentors: " : "Mentor: "}
												class="block before:text-muted before:content-[attr(data-label)] sm:table-cell sm:py-2 sm:before:content-none"
											>
												{s.mentor?.map((name, i) => (
													<>
														{i > 0 && ", "}
														{mentorSites.get(name) ? (
															<a href={mentorSites.get(name)} class="hover:text-accent hover:underline">
																{name}
															</a>
														) : (
															name
														)}
													</>
												))}
											</td>
										</tr>
									);
								})}
							</tbody>
						</table>
						{formerStudents.length > ROW_LIMIT && (
							<button
								type="button"
								class={collapseButtonClass}
								aria-expanded="false"
								aria-controls="former-students-rows"
								data-collapse-toggle
								data-label-more={`Show all ${formerStudents.length} former student researchers`}
								hidden
							>
								Show all {formerStudents.length} former student researchers
							</button>
						)}
					</div>
				)}
				{sortedVisitors.length > 0 && (
					<div class="mt-8 first:mt-0" data-collapsible>
						<h3 class="mb-6 text-sm font-semibold tracking-wide text-muted uppercase" data-collapsible-heading>
							Visitors
						</h3>
						<table class="block w-full text-sm sm:table">
							<thead class="hidden sm:table-header-group">
								<tr class="border-b border-line text-left">
									<th class="py-2 pr-4 font-semibold">Name</th>
									<th class="py-2 pr-4 font-semibold">Type</th>
									<th class="py-2 pr-4 font-semibold">Affiliation</th>
									<th class="py-2 font-semibold">Year</th>
								</tr>
							</thead>
							<tbody id="visitors-rows" class="block sm:table-row-group">
								{sortedVisitors.map((v, i) => (
									<tr
										class="block border-b border-line py-3 align-top sm:table-row sm:py-0"
										data-overflow={i >= ROW_LIMIT ? "" : undefined}
									>
										<td class="block font-semibold sm:table-cell sm:py-2 sm:pr-4">
											{v.website ? (
												<a href={v.website} class="hover:text-accent hover:underline">
													{v.name}
												</a>
											) : (
												v.name
											)}
										</td>
										<td
											data-label="Type: "
											class="block before:text-muted before:content-[attr(data-label)] sm:table-cell sm:py-2 sm:pr-4 sm:before:content-none"
										>
											{visitorTypes[v.type]}
										</td>
										<td
											data-label="Affiliation: "
											class="block before:text-muted before:content-[attr(data-label)] sm:table-cell sm:py-2 sm:pr-4 sm:before:content-none"
										>
											{v.country ? `${v.affiliation}, ${v.country}` : v.affiliation}
										</td>
										<td
											data-label="Year: "
											class="block before:text-muted before:content-[attr(data-label)] sm:table-cell sm:py-2 sm:whitespace-nowrap sm:before:content-none"
										>
											{visitorYears(v)}
										</td>
									</tr>
								))}
							</tbody>
						</table>
						{sortedVisitors.length > ROW_LIMIT && (
							<button
								type="button"
								class={collapseButtonClass}
								aria-expanded="false"
								aria-controls="visitors-rows"
								data-collapse-toggle
								data-label-more={`Show all ${sortedVisitors.length} visitors`}
								hidden
							>
								Show all {sortedVisitors.length} visitors
							</button>
						)}
					</div>
				)}
			</section>
		)
	}
</BaseLayout>

<script>
	// Without JS every row is shown and the buttons stay hidden.
	for (const toggle of document.querySelectorAll<HTMLButtonElement>("[data-collapse-toggle]")) {
		const rows = document.getElementById(toggle.getAttribute("aria-controls")!)!;
		const extra = rows.querySelectorAll<HTMLElement>("[data-overflow]");
		const heading = toggle.closest("[data-collapsible]")!.querySelector("[data-collapsible-heading]")!;
		const setExpanded = (expanded: boolean) => {
			for (const row of extra) row.hidden = !expanded;
			toggle.setAttribute("aria-expanded", String(expanded));
			toggle.textContent = expanded ? "Show fewer" : toggle.dataset.labelMore!;
		};
		setExpanded(false);
		toggle.hidden = false;
		toggle.addEventListener("click", () => {
			const expanded = toggle.getAttribute("aria-expanded") !== "true";
			setExpanded(expanded);
			if (!expanded) heading.scrollIntoView({ block: "start" });
		});
	}
</script>
