---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsItem from "../components/NewsItem.astro";
import { getNews } from "../utils/news";

const items = await getNews();
const years = [...new Set(items.map((item) => item.data.date.getUTCFullYear()))];
---

<BaseLayout
	title="News"
	description="News from the Computational Imaging Group at UW–Madison: accepted papers, awards, talks, grants, and group milestones."
>
	<h1 class="mb-4 text-3xl font-semibold">News</h1>

	{
		years.map((year) => (
			<section class="mt-10">
				<h2 class="mb-4 border-b border-line pb-2 text-xl font-semibold">{year}</h2>
				<ul class="space-y-3">
					{items
						.filter((item) => item.data.date.getUTCFullYear() === year)
						.map((item) => (
							<NewsItem item={item} />
						))}
				</ul>
			</section>
		))
	}
</BaseLayout>
