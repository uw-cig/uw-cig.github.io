---
import { statSync } from "node:fs";
import type { ImageMetadata } from "astro";
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard, { type ProjectMedia } from "../components/ProjectCard.astro";

const PROJECTS_SECTION = "student-researchers";

const MEDIA_DIR = "src/assets/projects";
// Static images are optimized by astro:assets; animations are served as-is (?url),
// since converting them can drop frames.
const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/projects/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG}", {
	eager: true,
});
const animations = import.meta.glob<string>("/src/assets/projects/*.{gif,mp4,webm,GIF,MP4,WEBM}", {
	query: "?url",
	import: "default",
	eager: true,
});
const MB = 1024 * 1024;
const SIZE_LIMITS: Record<string, number> = { gif: 3 * MB, mp4: 5 * MB, webm: 5 * MB };

function resolveMedia(file: string | undefined): ProjectMedia | undefined {
	if (!file) return undefined;
	const path = `/${MEDIA_DIR}/${file}`;
	const ext = file.split(".").pop()!.toLowerCase();
	const image = images[path]?.default;
	if (image) return { kind: "image", image };
	const src = animations[path];
	if (!src) {
		console.warn(`src/data/projects.yml: ${MEDIA_DIR}/${file} not found; showing a placeholder`);
		return undefined;
	}
	const size = statSync(`${MEDIA_DIR}/${file}`).size;
	if (size > SIZE_LIMITS[ext]) {
		console.warn(
			`src/data/projects.yml: ${MEDIA_DIR}/${file} is ${(size / MB).toFixed(1)} MB; keep ${ext === "gif" ? "GIFs under 3 MB" : "videos under 5 MB"} so the page loads quickly`,
		);
	}
	return ext === "gif" ? { kind: "gif", src } : { kind: "video", src };
}

const sections = await Promise.all(
	(await getCollection("join"))
		.filter((entry) => entry.data.status === "open")
		.sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id))
		.map(async (entry) => ({ ...entry, Content: (await render(entry)).Content })),
);

// Available projects first, then by semester and file order. Completed projects are not shown.
const projects = (await getCollection("projects"))
	.map((entry) => entry.data)
	.filter((p) => p.status !== "completed")
	.sort(
		(a, b) =>
			Number(a.status !== "available") - Number(b.status !== "available") ||
			a.semesterOrder - b.semesterOrder ||
			a.order - b.order,
	)
	.map((project) => ({ project, media: resolveMedia(project.media) }));

const available = projects.filter(({ project }) => project.status === "available").length;
const projectFilters = [
	{ status: "all", label: "All", count: projects.length },
	{ status: "available", label: "Available", count: available },
	{ status: "reserved", label: "Reserved", count: projects.length - available },
];
const mentorSites = new Map((await getCollection("team")).map(({ data }) => [data.name, data.website]));
const studentSites = new Map((await getCollection("students")).map(({ data }) => [data.name, data.website]));

const badgeFor = (id: string, label: string) =>
	id === PROJECTS_SECTION && available > 0 ? `${available} ${available === 1 ? "project" : "projects"} available` : label;
---

<BaseLayout
	title="Join"
	description="Opportunities to join the Computational Imaging Group at UW–Madison as a PhD student, postdoc, or student researcher, and how to apply."
>
	<h1 class="mb-4 text-3xl font-semibold">Join</h1>
	<p>We are always looking for curious, motivated people to work on computational imaging.</p>

	{
		sections.length === 0 ? (
			<p class="mt-10 text-muted">There are no open positions at the moment. Please check back later.</p>
		) : (
			<>
				<nav aria-label="Open positions" class="mt-6">
					<ul class="flex flex-wrap gap-2">
						{sections.map((section) => (
							<li>
								<a
									href={`#${section.id}`}
									class="inline-block rounded-full border border-line px-4 py-1.5 text-sm hover:border-accent hover:text-accent"
								>
									{section.data.title}
								</a>
							</li>
						))}
					</ul>
				</nav>

				{sections.map(({ id, data, Content }) => (
					<section id={id} class="mt-12 scroll-mt-6">
						<h2 class="mb-6 flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-line pb-2 text-xl font-semibold">
							{data.title}
							<span class="rounded-full bg-accent px-2.5 py-0.5 text-xs font-semibold text-white">
								{badgeFor(id, data.status_label)}
							</span>
						</h2>

						<div class="prose max-w-none [--tw-prose-body:var(--color-ink)] [--tw-prose-bold:var(--color-ink)] [--tw-prose-bullets:var(--color-muted)] [--tw-prose-counters:var(--color-muted)] [--tw-prose-headings:var(--color-ink)] [--tw-prose-hr:var(--color-line)] [--tw-prose-links:var(--color-accent)] [--tw-prose-quotes:var(--color-ink)] [--tw-prose-quote-borders:var(--color-line)] prose-a:no-underline hover:prose-a:underline">
							<Content />
						</div>

						{data.form && (
							<a
								href={data.form}
								target="_blank"
								rel="noopener"
								class="mt-6 inline-block rounded bg-accent px-4 py-2 text-sm font-semibold text-white hover:opacity-90"
							>
								Apply →
							</a>
						)}

						{id === PROJECTS_SECTION && projects.length > 0 && (
							<div class="mt-8">
								{/* Hidden until the script below runs, so without JS all cards show. */}
								<div data-project-filters hidden role="group" aria-label="Filter projects" class="mb-4 flex flex-wrap gap-2">
									{projectFilters.map(({ status, label, count }) => (
										<button
											type="button"
											data-project-filter={status}
											aria-pressed={status === "all" ? "true" : "false"}
											class="rounded-full border border-line px-3 py-1 text-sm hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-white"
										>
											{label} <span class="opacity-75">({count})</span>
										</button>
									))}
								</div>
								<div class="space-y-4">
									{projects.map(({ project, media }) => (
										<ProjectCard project={project} media={media} mentorSites={mentorSites} studentSites={studentSites} />
									))}
								</div>
							</div>
						)}
					</section>
				))}
			</>
		)
	}
</BaseLayout>

<script>
	const filters = document.querySelector<HTMLElement>("[data-project-filters]");
	if (filters) {
		const buttons = [...filters.querySelectorAll<HTMLButtonElement>("[data-project-filter]")];
		const cards = [...document.querySelectorAll<HTMLElement>("[data-project]")];
		for (const button of buttons) {
			button.addEventListener("click", () => {
				const status = button.dataset.projectFilter;
				for (const b of buttons) b.setAttribute("aria-pressed", String(b === button));
				for (const card of cards) card.hidden = status !== "all" && card.dataset.project !== status;
			});
		}
		filters.hidden = false;
	}

	// Project videos load only when scrolled into view, and play only while visible.
	// With reduced motion they load but stay paused on the first frame.
	const videos = [...document.querySelectorAll<HTMLVideoElement>("video[data-project-video]")];
	if (videos.length > 0) {
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		const observer = new IntersectionObserver(
			(entries) => {
				for (const { target, isIntersecting } of entries) {
					const video = target as HTMLVideoElement;
					if (isIntersecting) {
						if (!video.src) {
							video.preload = "auto";
							video.src = video.dataset.src!;
						}
						if (!reducedMotion.matches) video.play().catch(() => {});
					} else {
						video.pause();
					}
				}
			},
			{ rootMargin: "200px 0px" },
		);
		for (const video of videos) observer.observe(video);
	}
</script>
